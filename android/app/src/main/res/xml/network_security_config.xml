<?xml version="1.0" encoding="utf-8"?>
<!--
  DEVELOPMENT ONLY: permits plain-HTTP (cleartext) traffic to the local
  Supabase stack reached via the Android emulator's host alias (10.0.2.2)
  or a device-local loopback (127.0.0.1). Remove before any deployed build.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
